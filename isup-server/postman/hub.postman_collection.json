{
  "info": {
    "name": "Biometric Device Hub (ISUP)",
    "description": "HRM-facing API of the Java ISUP hub. Branch terminals dial in over ISUP; the HRM drives them here over HTTP/JSON.\n\nSet the environment first: hubUrl, deviceId (the ISUP Device ID, e.g. HRM02), employeeNo.\n\n{{deviceId}} must be an ONLINE device — check `GET /devices`. A request to an offline device returns 503.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "hubUrl", "value": "http://localhost:8090" },
    { "key": "deviceId", "value": "HRM02" },
    { "key": "employeeNo", "value": "E123" },
    { "key": "sourceDeviceId", "value": "HRM01" },
    { "key": "fingerPrintID", "value": "1" }
  ],
  "item": [
    {
      "name": "Hub",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{hubUrl}}/health", "host": ["{{hubUrl}}"], "path": ["health"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('ok', () => pm.expect(pm.response.json().ok).to.be.true);" ] } }]
        },
        {
          "name": "List devices (online)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{hubUrl}}/devices", "host": ["{{hubUrl}}"], "path": ["devices"] },
            "description": "Every connected terminal with its model + which adapter serves it." },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const d = pm.response.json();",
            "console.log('online devices: ' + JSON.stringify(d));" ] } }]
        }
      ]
    },
    {
      "name": "Device",
      "item": [
        {
          "name": "Device brief",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{hubUrl}}/devices/{{deviceId}}", "host": ["{{hubUrl}}"], "path": ["devices", "{{deviceId}}"] } }
        },
        {
          "name": "Device info (live ISAPI)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{hubUrl}}/devices/{{deviceId}}/info", "host": ["{{hubUrl}}"], "path": ["devices", "{{deviceId}}", "info"] },
            "description": "Runs /ISAPI/System/deviceInfo over the ISUP tunnel." }
        },
        {
          "name": "Capabilities",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{hubUrl}}/devices/{{deviceId}}/capabilities", "host": ["{{hubUrl}}"], "path": ["devices", "{{deviceId}}", "capabilities"] },
            "description": "What this model supports (persons, cards, fingerprint, face, max fingerprints)." }
        }
      ]
    },
    {
      "name": "Persons",
      "item": [
        {
          "name": "List persons",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{hubUrl}}/devices/{{deviceId}}/persons", "host": ["{{hubUrl}}"], "path": ["devices", "{{deviceId}}", "persons"] },
            "description": "Auto-paginated UserInfo/Search over ISUP." }
        },
        {
          "name": "Register / update person",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"employeeNo\": \"{{employeeNo}}\",\n  \"name\": \"Test User\"\n}" },
            "url": { "raw": "{{hubUrl}}/devices/{{deviceId}}/persons", "host": ["{{hubUrl}}"], "path": ["devices", "{{deviceId}}", "persons"] },
            "description": "Creates, or updates if the employeeNo already exists (auto Modify fallback)."
          }
        },
        {
          "name": "Delete person",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{hubUrl}}/devices/{{deviceId}}/persons/{{employeeNo}}", "host": ["{{hubUrl}}"], "path": ["devices", "{{deviceId}}", "persons", "{{employeeNo}}"] } }
        },
        {
          "name": "Register on ALL devices (broadcast)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"employeeNo\": \"{{employeeNo}}\",\n  \"name\": \"Test User\"\n}" },
            "url": { "raw": "{{hubUrl}}/persons/broadcast", "host": ["{{hubUrl}}"], "path": ["persons", "broadcast"] },
            "description": "Registers/updates the person on every online device at once — convenience for enrolling one employee across all branches."
          }
        },
        {
          "name": "Delete from ALL devices (broadcast)",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{hubUrl}}/persons/broadcast/{{employeeNo}}", "host": ["{{hubUrl}}"], "path": ["persons", "broadcast", "{{employeeNo}}"] } }
        }
      ]
    },
    {
      "name": "Cards",
      "item": [
        {
          "name": "Assign card",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"cardNo\": \"0012345678\",\n  \"cardType\": \"normalCard\"\n}" },
            "url": { "raw": "{{hubUrl}}/devices/{{deviceId}}/persons/{{employeeNo}}/card", "host": ["{{hubUrl}}"], "path": ["devices", "{{deviceId}}", "persons", "{{employeeNo}}", "card"] }
          }
        }
      ]
    },
    {
      "name": "Fingerprints",
      "item": [
        {
          "name": "List a person's fingerprints",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{hubUrl}}/devices/{{deviceId}}/persons/{{employeeNo}}/fingerprints", "host": ["{{hubUrl}}"], "path": ["devices", "{{deviceId}}", "persons", "{{employeeNo}}", "fingerprints"] },
            "description": "Returns each fingerprint incl. the Base64 template (used for cross-branch sync)." }
        },
        {
          "name": "Push a fingerprint template",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fingerPrintID\": {{fingerPrintID}},\n  \"fingerData\": \"PASTE_BASE64_TEMPLATE\"\n}" },
            "url": { "raw": "{{hubUrl}}/devices/{{deviceId}}/persons/{{employeeNo}}/fingerprint", "host": ["{{hubUrl}}"], "path": ["devices", "{{deviceId}}", "persons", "{{employeeNo}}", "fingerprint"] },
            "description": "FingerPrintDownload over ISUP. Use a template obtained from 'List fingerprints'."
          }
        },
        {
          "name": "Delete one fingerprint",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{hubUrl}}/devices/{{deviceId}}/persons/{{employeeNo}}/fingerprints/{{fingerPrintID}}", "host": ["{{hubUrl}}"], "path": ["devices", "{{deviceId}}", "persons", "{{employeeNo}}", "fingerprints", "{{fingerPrintID}}"] } }
        },
        {
          "name": "Cross-branch sync  ⭐",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"sourceDeviceId\": \"{{sourceDeviceId}}\",\n  \"employeeNo\": \"{{employeeNo}}\"\n}" },
            "url": { "raw": "{{hubUrl}}/fingerprints/sync", "host": ["{{hubUrl}}"], "path": ["fingerprints", "sync"] },
            "description": "Reads the person's fingerprint template(s) from sourceDeviceId and pushes them to every OTHER online device — enroll once at one branch, works at all.\n\nOptional: add \"targetDeviceIds\": [\"HRM03\",\"HRM04\"] to restrict targets."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const r = pm.response.json();",
            "console.log('templates found: ' + r.templatesFound + ', targets: ' + JSON.stringify(r.targets));" ] } }]
        }
      ]
    },
    {
      "name": "Doors",
      "item": [
        {
          "name": "Control door",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"doorNo\": 1,\n  \"cmd\": \"open\"\n}" },
            "url": { "raw": "{{hubUrl}}/devices/{{deviceId}}/door", "host": ["{{hubUrl}}"], "path": ["devices", "{{deviceId}}", "door"] },
            "description": "cmd: open | close | alwaysOpen | alwaysClose | resume"
          }
        }
      ]
    }
  ]
}
